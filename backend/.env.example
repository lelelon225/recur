JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo API-Key für den Versand von Verifizierungs-/Willkommens-E-Mails über
# die Brevo Transactional-Email-HTTP-API
BREVO_API_KEY=
MAIL_FROM=

# VAPID-Schlüsselpaar für Web-Push-Benachrichtigungen (#102). Erzeugen z.B.
# mit `npx web-push generate-vapid-keys`. Ohne diese Werte bleibt der
# Push-Versand deaktiviert (siehe PushNotificationService).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

